+# --- AppBar API (画面領域予約) ---
+WM_USER = 0x0400
+APPBAR_CALLBACK = WM_USER + 100
+ABM_NEW = 0x00000000
+ABM_REMOVE = 0x00000001
+ABM_QUERYPOS = 0x00000002
+ABM_SETPOS = 0x00000003
+ABE_BOTTOM = 3
+
+class APPBARDATA(ctypes.Structure):
+    _fields_ = [
+        ("cbSize", wintypes.DWORD),
+        ("hWnd", wintypes.HWND),
+        ("uCallbackMessage", ctypes.c_uint),
+        ("uEdge", ctypes.c_uint),
+        ("rc", wintypes.RECT),
+        ("lParam", ctypes.c_int),
+    ]
+
+def register_appbar(hwnd, left, top, right, bottom):
+    """AppBarとして登録し、画面の作業領域を予約する。
+    最大化されたウィンドウはこの領域を避ける。"""
+    abd = APPBARDATA()
+    abd.cbSize = ctypes.sizeof(APPBARDATA)
+    abd.hWnd = hwnd
+    abd.uCallbackMessage = APPBAR_CALLBACK
+    result = ctypes.windll.shell32.SHAppBarMessage(ABM_NEW, ctypes.byref(abd))
+    if not result:
+        print("[WARN] AppBar registration failed")
+        return False
+
+    abd.uEdge = ABE_BOTTOM
+    abd.rc.left = left
+    abd.rc.top = top
+    abd.rc.right = right
+    abd.rc.bottom = bottom
+    ctypes.windll.shell32.SHAppBarMessage(ABM_QUERYPOS, ctypes.byref(abd))
+    abd.rc.top = abd.rc.bottom - (bottom - top)
+    ctypes.windll.shell32.SHAppBarMessage(ABM_SETPOS, ctypes.byref(abd))
+    return True
+
+def unregister_appbar(hwnd):
+    """AppBar登録を解除し、予約した画面領域を解放する。"""
+    abd = APPBARDATA()
+    abd.cbSize = ctypes.sizeof(APPBARDATA)
+    abd.hWnd = hwnd
+    ctypes.windll.shell32.SHAppBarMessage(ABM_REMOVE, ctypes.byref(abd))
+
