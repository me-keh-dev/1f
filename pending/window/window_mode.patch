+# --- Window Mode Overlay (YouTube + pixel-art curtains) ---
+_webengine_available = _webengine_early_import
+
+
+class WallPainterWidget(QWidget):
+    """Transparent overlay that draws wall pieces + curtains + plants on top of QWebEngineView."""
+    def __init__(self, parent, config, wind_sim):
+        super().__init__(parent)
+        self.config = config
+        self.wind_sim = wind_sim
+        self.scene = None
+        self.wall_rects = []
+        self.frame_rects = []
+        self.setAttribute(Qt.WA_TranslucentBackground)
+        self.setAttribute(Qt.WA_TransparentForMouseEvents)
+
+    def rebuild(self, config, screen_width, widget_width, area_height):
+        self.config = config
+        from scenes.window import WindowScene, _compute_window_grid
+        self.scene = WindowScene()
+        self.scene.rebuild(config, screen_width, widget_width)
+
+        # Compute wall pieces for QPainter rendering
+        cols = config.get("win_columns", 3)
+        rows = config.get("win_rows", 1)
+        wall_t = config.get("win_wall_thickness", 22)
+        frame_w = 3
+
+        windows, win_w, win_h = _compute_window_grid(
+            widget_width, area_height, cols, rows, wall_t, wall_t, frame_w
+        )
+
+        # Build wall rects (same logic as HTML version)
+        self.wall_rects = []
+        # Top bar
+        self.wall_rects.append((0, 0, widget_width, wall_t))
+        # Bottom bar
+        if windows:
+            last_bottom = max(wy + wh for (wx, wy, ww, wh) in windows)
+            self.wall_rects.append((0, last_bottom, widget_width, area_height - last_bottom))
+        # Horizontal bars between rows
+        for r in range(1, rows):
+            bar_y = wall_t + r * (win_h + wall_t) - wall_t
+            self.wall_rects.append((0, bar_y, widget_width, wall_t))
+        # Vertical pillars
+        for r in range(rows):
+            row_y = wall_t + r * (win_h + wall_t)
+            self.wall_rects.append((0, row_y, wall_t, win_h))
+            for c in range(1, cols):
+                px = wall_t + c * (win_w + wall_t) - wall_t
+                self.wall_rects.append((px, row_y, wall_t, win_h))
+            right_x = wall_t + cols * (win_w + wall_t) - wall_t
+            self.wall_rects.append((right_x, row_y, widget_width - right_x, win_h))
+
+        # Frame rects
+        self.frame_rects = [(wx, wy, ww, wh) for (wx, wy, ww, wh) in windows]
+
+    def update_scene(self):
+        if self.scene:
+            mx, my = get_cursor_pos()
+            p = self.parent()
+            if p:
+                self.scene.update(self.wind_sim, mouse_pos=(mx - p.x(), my - p.y()))
+        self.update()
+
+    def paintEvent(self, event):
+        painter = QPainter(self)
+        painter.setRenderHint(QPainter.Antialiasing, False)
+
+        # Draw wall pieces (opaque concrete look)
+        wall_color = QColor(0x1e, 0x1e, 0x2e)
+        wall_light = QColor(0x2a, 0x2a, 0x3e)
+        wall_dark = QColor(0x14, 0x14, 0x20)
+        for (rx, ry, rw, rh) in self.wall_rects:
+            # Vertical gradient: lighter at top, darker at bottom
+            for y in range(rh):
+                ratio = y / max(1, rh - 1)
+                r = int(wall_light.red() + (wall_dark.red() - wall_light.red()) * ratio)
+                g = int(wall_light.green() + (wall_dark.green() - wall_light.green()) * ratio)
+                b = int(wall_light.blue() + (wall_dark.blue() - wall_light.blue()) * ratio)
+                painter.fillRect(rx, ry + y, rw, 1, QColor(r, g, b))
+            # Subtle mortar lines
+            for y in range(0, rh, 10):
+                painter.fillRect(rx, ry + y, rw, 1, QColor(255, 255, 255, 4))
+
+        # Draw window frames
+        frame_color = QColor(0x3a, 0x3a, 0x4e)
+        frame_hi = QColor(0x4a, 0x4a, 0x5e)
+        frame_lo = QColor(0x30, 0x30, 0x40)
+        fw = 3
+        for (wx, wy, ww, wh) in self.frame_rects:
+            # Top frame
+            painter.fillRect(wx - fw, wy - fw, ww + fw * 2, fw, frame_hi)
+            # Bottom frame
+            painter.fillRect(wx - fw, wy + wh, ww + fw * 2, fw, frame_lo)
+            # Left frame
+            painter.fillRect(wx - fw, wy, fw, wh, frame_color)
+            # Right frame
+            painter.fillRect(wx + ww, wy, fw, wh, frame_color)
+            # Inner shadow (subtle darkening around edges)
+            shadow = QColor(0, 0, 0, 40)
+            painter.fillRect(wx, wy, ww, 3, shadow)
+            painter.fillRect(wx, wy, 3, wh, shadow)
+            painter.fillRect(wx, wy + wh - 3, ww, 3, shadow)
+            painter.fillRect(wx + ww - 3, wy, 3, wh, shadow)
+
+        # Draw curtains and plants (1/f yuragi foreground)
+        lighting_mode = self.config.get("lighting_mode", "off")
+        if lighting_mode == "auto":
+            tint = _get_time_tint()
+        elif lighting_mode in LIGHTING_PRESETS:
+            tint = LIGHTING_PRESETS[lighting_mode]
+        else:
+            tint = None
+
+        get_alpha = None
+        if self.config.get("mouse_fade_enabled", True):
+            mx, my = get_cursor_pos()
+            inner_r = self.config.get("mouse_fade_inner", 30)
+            fade_r = self.config.get("mouse_fade_range", 120)
+            min_alpha = self.config.get("mouse_fade_alpha", 15)
+            p = self.parent()
+            gy = (p.y() if p else 0) + self.height() // 2
+            widget_x = p.x() if p else 0
+            def get_alpha(base_x):
+                gx = widget_x + base_x
+                dist = math.sqrt((mx - gx) ** 2 + (my - gy) ** 2)
+                if dist <= inner_r:
+                    return min_alpha
+                elif dist <= inner_r + fade_r:
+                    t_val = (dist - inner_r) / fade_r
+                    return int(min_alpha + (255 - min_alpha) * t_val)
+                return 255
+
+        if self.scene:
+            self.scene.draw(painter, self.height(), tint, get_alpha)
+        painter.end()
+
+
+class WindowOverlay(QWidget):
+    """Window mode overlay: QWebEngineView (YouTube) + WallPainterWidget (walls/curtains).
+    Loads the actual YouTube watch page (no embedding restrictions).
+    Registers as AppBar to reserve screen space.
+    """
+    def __init__(self, screen, config, wind_sim):
+        super().__init__()
+        self.screen = screen
+        self.config = config
+        self.wind_sim = wind_sim
+        self.scene = None
+        self.web_view = None
+        self._appbar_registered = False
+
+        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Tool)
+        self.setStyleSheet("background: #0a0a14;")
+
+        self._position_window()
+        self._create_web_view()
+        self.show()
+        QTimer.singleShot(100, self._setup_window)
+
+    def _setup_window(self):
+        if sys.platform == "win32":
+            hwnd = int(self.winId())
+            set_not_topmost(hwnd)
+        self._register_appbar()
+
+    def _register_appbar(self):
+        if sys.platform != "win32":
+            return
+        hwnd = int(self.winId())
+        geo = self.geometry()
+        self._appbar_registered = register_appbar(
+            hwnd, geo.x(), geo.y(), geo.x() + geo.width(), geo.y() + geo.height()
+        )
+
+    def _unregister_appbar(self):
+        if self._appbar_registered and sys.platform == "win32":
+            unregister_appbar(int(self.winId()))
+            self._appbar_registered = False
+
+    def _position_window(self):
+        # Only calculate position once (before AppBar registration changes availableGeometry)
+        if not hasattr(self, '_fixed_geometry'):
+            full = self.screen.geometry()
+            avail = self.screen.availableGeometry()
+            taskbar_h = full.height() - avail.height()
+            taskbar_top = avail.y() + avail.height()
+            if taskbar_h < 10:
+                taskbar_top = full.y() + full.height() - 48
+
+            scene_cls = get_scene_class("window")
+            temp_scene = scene_cls()
+            area_height = temp_scene.get_area_height(self.config)
+            self.area_height = area_height
+            self.ground_y = area_height
+            self._fixed_geometry = (full.x(), taskbar_top - area_height, full.width(), area_height)
+
+        self.setGeometry(*self._fixed_geometry)
+
+    def _rebuild_scene(self):
+        # Walls are rendered in HTML inside QWebEngineView, so rebuild = recreate web view
+        self._create_web_view()
+
+    def _create_web_view(self):
+        if not _webengine_available:
+            return
+        if self.web_view:
+            try:
+                self.web_view.setUrl(QUrl("about:blank"))
+                self.web_view.deleteLater()
+            except RuntimeError:
+                pass
+            self.web_view = None
+
+        from scenes.window import DEFAULT_CAMERAS, generate_window_html
+
+        # Get video URL
+        camera_idx = self.config.get("win_camera_idx", 0)
+        custom_url = self.config.get("win_custom_url", "")
+        if custom_url:
+            raw_url = custom_url
+        elif camera_idx < len(DEFAULT_CAMERAS):
+            raw_url = DEFAULT_CAMERAS[camera_idx]["url"]
+        else:
+            raw_url = ""
+
+        # Extract direct stream URL via yt-dlp (avoids YouTube JS which crashes QtWebEngine 5.15)
+        stream_url = self._get_stream_url(raw_url) if raw_url else ""
+
+        # Clip position
+        clip_x = self.config.get("win_clip_x", 50)
+        clip_y = self.config.get("win_clip_y", 50)
+        clip_zoom = self.config.get("win_clip_zoom", 150)
+
+        # Generate HTML with video + CSS walls in one page
+        cols = self.config.get("win_columns", 3)
+        rows = self.config.get("win_rows", 1)
+        wall_thickness = self.config.get("win_wall_thickness", 22)
+
+        html = generate_window_html(
+            stream_url, self.width(), self.height(),
