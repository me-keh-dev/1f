# ===== flights_server (M1) =====
# 航空データ・バックエンド（adsb.lol を サーバ単位 で集約し、全クライアントへ配信）
# 秘密情報は置かない。実値は .env（.gitignore 済み）に。

PORT=8080

# --- 外部ポーリング（adsb.lol）---
# 外部呼び出しの「周期」。この周期ごとに *1回だけ* 外部APIを叩き、
# アクティブな bbox を 1つずつ ラウンドロビンで更新する（周期÷bbox数 ではない）。
EXTERNAL_POLL_PERIOD_MS=10000

# 外部レートの *絶対上限*（req/s）。adsb.lol は動的制限のため保守的に。
# レートリミッタがこの間隔を強制し、何があっても超えない。
MAX_EXTERNAL_RPS=1

# adsb.lol ベースURL（ADSBExchange v2 互換）
ADSBLOL_BASE_URL=https://api.adsb.lol/v2

# 円クエリの最大半径(NM)。v2 の上限に合わせてクランプ。
MAX_QUERY_RADIUS_NM=250

# 機体の鮮度: seen(秒) がこれを超えた機体はスナップショットから除外
MAX_AGE_SEC=60

# --- 配信（クライアント向け・外部ポーリングとは別物）---
# WS のクライアントへの push 間隔(ms)。表示の滑らかさはクライアント補間が担う。
WS_PUSH_INTERVAL_MS=1000
# REST で要求した bbox を poller 対象に保つ寿命(ms)。再要求が無ければ解除。
REST_REGISTER_TTL_MS=30000

# 公開ドメイン（出典表示用）/ CORS 許可オリジン（CF前段でも保険）
PUBLIC_DOMAIN=example.com
CORS_ORIGINS=*
